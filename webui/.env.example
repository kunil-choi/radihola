# copy this to webui/.env and fill in the values

# a GitHub Personal Access Token with permission to dispatch workflows and
# read Actions runs/artifacts on kunil-choi/radihola
# (fine-grained PAT: Actions=Read&Write, Contents=Read is enough)
GITHUB_TOKEN=

# owner/repo
GITHUB_REPO=kunil-choi/radihola

# branch that render-short.yml should be dispatched against
GITHUB_REF=main
