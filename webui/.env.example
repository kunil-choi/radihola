# copy this to webui/.env and fill in the values

# required: analyze-url uses the Claude API to propose shorts candidates
ANTHROPIC_API_KEY=

# optional: only needed if YouTube starts blocking your own IP with
# "Sign in to confirm you're not a bot" (rare on a home/office network,
# common on cloud IPs). See README.md's cookie section for how to get this.
# Absolute path to a cookies.txt file exported from a logged-in browser session.
YTDLP_COOKIES_FILE=

# optional: bold font used for the title/logo/caption text burned into
# rendered shorts. Defaults to a NanumGothicBold path that only exists on
# Linux. On Windows, point this at a Korean bold font already on the system,
# e.g. C:/Windows/Fonts/malgunbd.ttf (Malgun Gothic Bold) - no special
# escaping needed even though the path has a colon in it.
RADIHOLA_FONT=
