{
  "source": "youtube_captions",
  "segments": [
    {
      "start_sec": 2.51,
      "end_sec": 2.52,
      "text": "정부처에서 공급과 금융 세제에 대한"
    },
    {
      "start_sec": 2.52,
      "end_sec": 5.19,
      "text": "종합적인 그 접근을 하는 것은 굉장히"
    },
    {
      "start_sec": 5.2,
      "end_sec": 7.07,
      "text": "바람직한 상황이라고 생각을 합니다."
    },
    {
      "start_sec": 7.08,
      "end_sec": 7.71,
      "text": "&gt;&gt; 요약해서"
    },
    {
      "start_sec": 7.72,
      "end_sec": 10.15,
      "text": "&gt;&gt; 민간 장기 임대를 건설로 통해서"
    },
    {
      "start_sec": 10.16,
      "end_sec": 12.589,
      "text": "공급하는 사업자를 집단적으로 육성하는"
    },
    {
      "start_sec": 12.599,
      "end_sec": 14.39,
      "text": "제도와 시스템과 공급자 금융을"
    },
    {
      "start_sec": 14.4,
      "end_sec": 17.67,
      "text": "도입하셔서 민간 분양과 분절을 시켜야"
    },
    {
      "start_sec": 17.68,
      "end_sec": 19.349,
      "text": "지금 민간 분양 및 매매 시장에"
    },
    {
      "start_sec": 19.359,
      "end_sec": 21.47,
      "text": "도입하려고 하는 여러 규제들이나"
    },
    {
      "start_sec": 21.48,
      "end_sec": 23.589,
      "text": "보유세 같은 그런 제도들이 도관처럼"
    },
    {
      "start_sec": 23.599,
      "end_sec": 25.109,
      "text": "민간 임대 시장으로 흘러오지"
    },
    {
      "start_sec": 25.119,
      "end_sec": 26.83,
      "text": "않거든요. 그 이론적으로는 그럴"
    },
    {
      "start_sec": 26.84,
      "end_sec": 29.83,
      "text": "듯한데 민간업자 입장에서 왜 임대를"
    },
    {
      "start_sec": 29.84,
      "end_sec": 31.669,
      "text": "하겠어요? 분양을 하지. 본질적인"
    },
    {
      "start_sec": 31.679,
      "end_sec": 34.15,
      "text": "문제는 신축할 부지가 거의 없다는"
    },
    {
      "start_sec": 34.16,
      "end_sec": 35.67,
      "text": "거예요. 부지를 어떻게 확보합니까?"
    },
    {
      "start_sec": 35.68,
      "end_sec": 37.31,
      "text": "&gt;&gt; 도심 내에 주거용지만 있는 것이"
    },
    {
      "start_sec": 37.32,
      "end_sec": 38.67,
      "text": "아니라 비주고 용지도 많고 유효"
    },
    {
      "start_sec": 38.68,
      "end_sec": 41.19,
      "text": "부지도 많고 용도를 전환하거나 할 수"
    },
    {
      "start_sec": 41.2,
      "end_sec": 42.27,
      "text": "있는 용지들도 많이 있습니다."
    },
    {
      "start_sec": 42.28,
      "end_sec": 43.67,
      "text": "&gt;&gt; 그런 것들은 발굴 해야 되겠죠."
    },
    {
      "start_sec": 43.68,
      "end_sec": 45.51,
      "text": "초반에 좀 발언을 요청하셨는데"
    },
    {
      "start_sec": 45.52,
      "end_sec": 47.069,
      "text": "저한테는 좀 굉장히 시간을 타이트하게"
    },
    {
      "start_sec": 47.079,
      "end_sec": 49.069,
      "text": "주셨습니다. 발언을 잘 못했거든요."
    },
    {
      "start_sec": 49.079,
      "end_sec": 50.51,
      "text": "그래서 지금 좀 발언을 더 이어"
    },
    {
      "start_sec": 50.52,
      "end_sec": 52.75,
      "text": "나간다면은 매년 오피스텔를 포함해서"
    },
    {
      "start_sec": 52.76,
      "end_sec": 54.229,
      "text": "비아파트가 서울시에 8만 원씩"
    },
    {
      "start_sec": 54.239,
      "end_sec": 56.15,
      "text": "공급됐는데 지금은 2만밖에 공급이 안"
    },
    {
      "start_sec": 56.16,
      "end_sec": 58.67,
      "text": "되고 있고 4년 연속 누적됐기 때문에"
    },
    {
      "start_sec": 58.68,
      "end_sec": 60.31,
      "text": "비아파트 공급을 육성하는 금융"
    },
    {
      "start_sec": 60.32,
      "end_sec": 62.15,
      "text": "프로그램이 현재 없고 그런 거를 좀"
    },
    {
      "start_sec": 62.16,
      "end_sec": 64.469,
      "text": "지적을 하려고 했습니다. 주택"
    },
    {
      "start_sec": 64.479,
      "end_sec": 66.429,
      "text": "용지에서는 주택 공급을 하는게 아파트"
    },
    {
      "start_sec": 66.439,
      "end_sec": 68.59,
      "text": "공급을 하는게 맞지만 준주거나 상업"
    },
    {
      "start_sec": 68.6,
      "end_sec": 70.469,
      "text": "용지나 다른 용지들에서 얼마든지"
    },
    {
      "start_sec": 70.479,
      "end_sec": 72.27,
      "text": "비아파트 공급을 할 수가 있다 보니까"
    },
    {
      "start_sec": 72.28,
      "end_sec": 73.789,
      "text": "그런 공급을 많이 하면 좋겠다는"
    },
    {
      "start_sec": 73.799,
      "end_sec": 75.23,
      "text": "생각을 했고 특히 이것도 어떻게 보면"
    },
    {
      "start_sec": 75.24,
      "end_sec": 76.87,
      "text": "부동산 금융이잖아요. 지금 부동산"
    },
    {
      "start_sec": 76.88,
      "end_sec": 78.67,
      "text": "금융이란 수요자 금융, 그러니까 집을"
    },
    {
      "start_sec": 78.68,
      "end_sec": 80.469,
      "text": "사거나 이런 금융들만 얘기하셨는데"
    },
    {
      "start_sec": 80.479,
      "end_sec": 82.069,
      "text": "공급자 금융 얘기가 좀 없어서 굉장히"
    },
    {
      "start_sec": 82.07900000000001,
      "end_sec": 84.52,
      "text": "아쉬웠습니다."
    }
  ]
}