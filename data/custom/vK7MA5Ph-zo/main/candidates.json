          "start_sec": 1153.48,
          "end_sec": 1155.35,
          "text": "보면 여기에 내포돼 있는 거가 아니냐"
        },
        {
          "start_sec": 1155.36,
          "end_sec": 1157.39,
          "text": "이렇게 또 생각합니다."
        }
