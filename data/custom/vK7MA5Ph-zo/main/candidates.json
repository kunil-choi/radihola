        {
          "start_sec": 1816.919,
          "end_sec": 1819.149,
          "text": "어떻게 피를 보게 되는 거잖아요."
        },
        {
          "start_sec": 1819.159,
          "end_sec": 1821.509,
          "text": "쉽지 않기 때문에 여기에 대해서 쉽게"
        },
        {
          "start_sec": 1821.519,
          "end_sec": 1823.269,
          "text": "어 그렇게 될 수 없기 때문에 어"
        },
        {
          "start_sec": 1823.279,
          "end_sec": 1825.71,
          "text": "소위 말하는 롱스톱 이제 달러롱 같은"
        },
        {
          "start_sec": 1825.72,
          "end_sec": 1828.149,
          "text": "사람들도 스톱을 하는 거고요. 이제"
        },
        {
          "start_sec": 1828.159,
          "end_sec": 1830.07,
          "text": "그런 것들을 커버하는 그런 트레이드가"
        },
        {
          "start_sec": 1830.08,
          "end_sec": 1831.59,
          "text": "계속해서 나오게 되고요. 그런"
        },
        {
          "start_sec": 1831.6,
          "end_sec": 1833.549,
          "text": "상황에서 이제 빨리 그런 커버"
        },
        {
          "start_sec": 1833.559,
          "end_sec": 1835.11,
          "text": "트레이드가 일어나기 때문에"
        },
        {
          "start_sec": 1835.12,
          "end_sec": 1837.99,
          "text": "1,500원대 있던 환율들이 환율이"
        },
        {
          "start_sec": 1838.0,
          "end_sec": 1840.029,
          "text": "1,400원대로 빨리 하락하는 그런"
        },
        {
          "start_sec": 1840.039,
          "end_sec": 1841.71,
          "text": "상황이 나타난 것으로 볼 수가"
