{
  "source": "youtube_captions",
  "segments": [
    {
      "start_sec": 2.389,
      "end_sec": 2.399,
      "text": "쿠팡의 개인 정보 유출 사태가 아주"
    },
    {
      "start_sec": 2.399,
      "end_sec": 4.829,
      "text": "컸죠. 어, 소비자 분쟁 조정"
    },
    {
      "start_sec": 4.839,
      "end_sec": 7.47,
      "text": "위원회가 1인당 10만 원씩의"
    },
    {
      "start_sec": 7.48,
      "end_sec": 10.47,
      "text": "배상원을 내놓기도 했는데요.이 집단"
    },
    {
      "start_sec": 10.48,
      "end_sec": 12.589,
      "text": "분쟁 조정 제도에 대한 관심도"
    },
    {
      "start_sec": 12.599,
      "end_sec": 14.95,
      "text": "큽니다. 슬기로운 법률 생활 시간에"
    },
    {
      "start_sec": 14.96,
      "end_sec": 16.67,
      "text": "한번 들어보시죠. 법무법인 길도"
    },
    {
      "start_sec": 16.68,
      "end_sec": 18.23,
      "text": "윤예림 변호사와 함께합니다."
    },
    {
      "start_sec": 18.24,
      "end_sec": 18.67,
      "text": "안녕하세요."
    },
    {
      "start_sec": 18.68,
      "end_sec": 20.269,
      "text": ">> 안녕하세요. 윤예림입니다."
    },
    {
      "start_sec": 20.279,
      "end_sec": 21.59,
      "text": ">> 일단 조정이고"
    },
    {
      "start_sec": 21.6,
      "end_sec": 22.189,
      "text": ">> 네."
    },
    {
      "start_sec": 22.199,
      "end_sec": 24.55,
      "text": ">> 집단 분쟁 조정 제도예요. 그럼 그"
    },
    {
      "start_sec": 24.56,
      "end_sec": 26.429,
      "text": "집단은 몇 명이 모여야 되는 거예요?"
    },
    {
      "start_sec": 26.439,
      "end_sec": 26.87,
      "text": "일단 [목을 가다듬음]"
    },
    {
      "start_sec": 26.88,
      "end_sec": 29.47,
      "text": ">> 일단은 집단 분쟁 조정 제도의 요건을"
    },
    {
      "start_sec": 29.48,
      "end_sec": 31.87,
      "text": "살펴보기 위해서 제도의 의부터 좀"
    },
    {
      "start_sec": 31.88,
      "end_sec": 34.229,
      "text": "잠깐 말씀드릴게요. 개인 정보 유출"
    },
    {
      "start_sec": 34.239,
      "end_sec": 36.63,
      "text": "사고 같은 경우에는 대부분 동시에"
    },
    {
      "start_sec": 36.64,
      "end_sec": 38.91,
      "text": "많은 분들의 정보가 유출되잖아요."
    },
    {
      "start_sec": 38.92,
      "end_sec": 40.91,
      "text": "그렇게 되면 유출된 개인 정보의"
    },
    {
      "start_sec": 40.92,
      "end_sec": 43.47,
      "text": "항목이나 뭐 피해의 유형도 같거나 좀"
    },
    {
      "start_sec": 43.48,
      "end_sec": 46.51,
      "text": "유사합니다. 이렇게 작게는 수천권 뭐"
    },
    {
      "start_sec": 46.52,
      "end_sec": 49.15,
      "text": "많게는 수천만 건에 이루는 개인 정보"
    },
    {
      "start_sec": 49.16,
      "end_sec": 52.79,
      "text": "유출 사건을 개별적으로 하나하나 분쟁"
    },
    {
      "start_sec": 52.8,
      "end_sec": 54.79,
      "text": "조정 절차를 통해서 처리하게 되면은"
    },
    {
      "start_sec": 54.8,
      "end_sec": 56.549,
      "text": "시간도 낭비되고 비용도 많이"
    },
    {
      "start_sec": 56.559,
      "end_sec": 60.43,
      "text": "낭비되겠죠."
    },
    {
      "start_sec": 62.509,
      "end_sec": 62.519,
      "text": "신속"
    },
    {
      "start_sec": 62.519,
      "end_sec": 65.91,
      "text": "하나의 분쟁조절를 해일으로 해결하기"
    },
    {
      "start_sec": 65.92,
      "end_sec": 68.429,
      "text": "위해서 집단으로 분쟁 조정 제도를"
    },
    {
      "start_sec": 68.439,
      "end_sec": 71.07,
      "text": "마련한 것입니다.이 같은 경우는"
    },
    {
      "start_sec": 71.08,
      "end_sec": 73.749,
      "text": "일단은 피해 또는 분 그 권리 치매를"
    },
    {
      "start_sec": 73.759,
      "end_sec": 75.91,
      "text": "입으신 분의 수가 50인 이상이"
    },
    {
      "start_sec": 75.92,
      "end_sec": 77.63,
      "text": "되어야 되는 조건이 충족되어야"
    },
    {
      "start_sec": 77.64,
      "end_sec": 80.27,
      "text": "됩니다. 또이 집단 분쟁 조정 신청"
    },
    {
      "start_sec": 80.28,
      "end_sec": 83.63,
      "text": "사건의 중요한 쟁점은 사실상 또는"
    },
    {
      "start_sec": 83.64,
      "end_sec": 85.83,
      "text": "법률상 공통되어야 됩니다. 그니까"
    },
    {
      "start_sec": 85.84,
      "end_sec": 88.069,
      "text": "정리하면은 같은 피해를 입은 사람이"
    },
    {
      "start_sec": 88.07900000000001,
      "end_sec": 90.91,
      "text": "50명 이상 그리고 피해 원인과 법적"
    },
    {
      "start_sec": 90.92,
      "end_sec": 92.749,
      "text": "쟁점이 같아야 한다.이 두 가지"
    },
    {
      "start_sec": 92.759,
      "end_sec": 94.469,
      "text": "요건이 갖춰져야 됩니다. 근데"
    },
    {
      "start_sec": 94.479,
      "end_sec": 95.71000000000001,
      "text": "그렇다면 또 이제 누가 할 수"
    },
    {
      "start_sec": 95.72,
      "end_sec": 98.03,
      "text": "있냐라고 궁금하실 수 있는데 이미"
    },
    {
      "start_sec": 98.03999999999999,
      "end_sec": 100.71000000000001,
      "text": "사업자와 합의를 했거나 다른 법률에"
    },
    {
      "start_sec": 100.72,
      "end_sec": 102.789,
      "text": "따라서 분쟁 조정 절차를 진행 중인"
    },
    {
      "start_sec": 102.799,
      "end_sec": 105.22999999999999,
      "text": "소비자 뭐 해당 사건으로 법원에 이미"
    },
    {
      "start_sec": 105.24000000000001,
      "end_sec": 108.069,
      "text": "소송을 제기한 소비자라면대 그 집단"
    },
    {
      "start_sec": 108.07900000000001,
      "end_sec": 110.59,
      "text": "분쟁 조정 제도의 제도의 재 대상에서"
    },
    {
      "start_sec": 110.6,
      "end_sec": 112.95,
      "text": "제외가 되고요. 여기에 해당되지 않는"
    },
    {
      "start_sec": 112.96000000000001,
      "end_sec": 114.63,
      "text": "피해 입으신 분들만 참여할 수"
    },
    {
      "start_sec": 114.64,
      "end_sec": 116.83,
      "text": "있습니다네. 그러면 그 피해를 입은"
    },
    {
      "start_sec": 116.84,
      "end_sec": 118.83,
      "text": "사람들이 또 어떻게 모일 것이냐"
    },
    {
      "start_sec": 118.84,
      "end_sec": 121.109,
      "text": "이것도 핵심이잖아요. 뭐 어떤 변호사"
    },
    {
      "start_sec": 121.119,
      "end_sec": 123.109,
      "text": "사무실에서 모이자고 하는 건지 어떻게"
    },
    {
      "start_sec": 123.119,
      "end_sec": 124.51,
      "text": "해야 됩니다. 시작. 일단은"
    },
    {
      "start_sec": 124.52,
      "end_sec": 127.31,
      "text": "실무적으로는 어 피해자들이 먼저"
    },
    {
      "start_sec": 127.32,
      "end_sec": 129.309,
      "text": "자발적으로 모이는 경우들이 많잖아요."
    },
    {
      "start_sec": 129.319,
      "end_sec": 131.11,
      "text": "요즘에는 뭐 인터넷 카페, 오픈"
    },
    {
      "start_sec": 131.12,
      "end_sec": 132.949,
      "text": "채팅방, SNS 뭐 이렇게 모임할 수"
    },
    {
      "start_sec": 132.959,
      "end_sec": 135.43,
      "text": "있는 곳들이 많으니까 여기서 피해를"
    },
    {
      "start_sec": 135.44,
      "end_sec": 137.79,
      "text": "입으신 분들이 자연스럽게 모여서 뭐"
    },
    {
      "start_sec": 137.8,
      "end_sec": 139.99,
      "text": "쿠팡 개인 정보 유출 피해자 모임과"
    },
    {
      "start_sec": 140.0,
      "end_sec": 142.35,
      "text": "같은 카페를 만들고 거기서 함께"
    },
    {
      "start_sec": 142.36,
      "end_sec": 144.91,
      "text": "집단적으로 대응하는 방법을 논의하다가"
    },
    {
      "start_sec": 144.92000000000002,
      "end_sec": 147.22899999999998,
      "text": "변호사를 선임하는 경우 이제 한국"
    },
    {
      "start_sec": 147.239,
      "end_sec": 149.47,
      "text": "소비자원의 집단 분쟁 조정을 신청하는"
    },
    {
      "start_sec": 149.48,
      "end_sec": 151.07,
      "text": "경우들이 있고 아니면 변호사"
    },
    {
      "start_sec": 151.07999999999998,
      "end_sec": 152.39,
      "text": "사무실에서 요즘에는 모집도 많이"
    },
    {
      "start_sec": 152.4,
      "end_sec": 154.03,
      "text": "하시잖아요. 피해자 모적 공고를"
    },
    {
      "start_sec": 154.04,
      "end_sec": 156.35,
      "text": "내거나 뭐 이미 연락다운 피해자들이"
    },
    {
      "start_sec": 156.36,
      "end_sec": 158.309,
      "text": "서로 이제 연결된 것을 이제 소개해"
    },
    {
      "start_sec": 158.31900000000002,
      "end_sec": 160.50900000000001,
      "text": "준 거 이런 부분들이 있습니다. 네."
    },
    {
      "start_sec": 160.519,
      "end_sec": 162.949,
      "text": "집단 분쟁 조정 신청 자체는 사실"
    },
    {
      "start_sec": 162.959,
      "end_sec": 165.309,
      "text": "변호사 없이도 가능합니다. 근데 법적"
    },
    {
      "start_sec": 165.31900000000002,
      "end_sec": 167.949,
      "text": "쟁점이 복잡하거나 이제 기업 측에서"
    },
    {
      "start_sec": 167.959,
      "end_sec": 170.43,
      "text": "강하게 다툴 수 있는 가능성이 있으면"
    },
    {
      "start_sec": 170.44,
      "end_sec": 171.869,
      "text": "변호사의 도움을 받는 것이 유리할"
    },
    {
      "start_sec": 171.879,
      "end_sec": 175.07,
      "text": "수도 있겠죠. 그리고 쿠팡 사례를"
    },
    {
      "start_sec": 175.07999999999998,
      "end_sec": 177.27,
      "text": "보면 그 조정위원에서 1인당 10만"
    },
    {
      "start_sec": 177.28,
      "end_sec": 179.55,
      "text": "원씩의 배상 조정안을 권고를"
    },
    {
      "start_sec": 179.56,
      "end_sec": 180.03,
      "text": "했잖아요."
    },
    {
      "start_sec": 180.04,
      "end_sec": 182.949,
      "text": ">> 네네. 근데 이게 적당한 건지 많은"
    },
    {
      "start_sec": 182.959,
      "end_sec": 185.35,
      "text": "건지 적은 건지 요것 따져보기도"
    },
    {
      "start_sec": 185.36,
      "end_sec": 185.869,
      "text": "어려워요."
    },
    {
      "start_sec": 185.879,
      "end_sec": 187.55,
      "text": ">> 네. 사실 요게 일괄적으로 많은"
    },
    {
      "start_sec": 187.56,
      "end_sec": 189.149,
      "text": "편이다, 적은 편이다라고 말씀드리기"
    },
    {
      "start_sec": 189.159,
      "end_sec": 191.03,
      "text": "조금 어렵지만 좀 과거 사례들을 좀"
    },
    {
      "start_sec": 191.04,
      "end_sec": 193.309,
      "text": "살펴볼게요. 소비자 분쟁 조정"
    },
    {
      "start_sec": 193.319,
      "end_sec": 195.43,
      "text": "위원회에서 하는 그러니까 지금 쿠팡이"
    },
    {
      "start_sec": 195.44,
      "end_sec": 197.19,
      "text": "쿠팡 사건에 대해서 이제 이용한"
    },
    {
      "start_sec": 197.2,
      "end_sec": 198.82999999999998,
      "text": "제도입니다. 소비자 분쟁 조정"
    },
    {
      "start_sec": 198.84,
      "end_sec": 201.789,
      "text": "위원회에서 한 경우에는 과거 기업들의"
    },
    {
      "start_sec": 201.799,
      "end_sec": 204.11,
      "text": "대규모 정보 유출 사건에서 이제"
    },
    {
      "start_sec": 204.12,
      "end_sec": 206.149,
      "text": "1인당 위자료가 만 원 정도 인정된"
    },
    {
      "start_sec": 206.159,
      "end_sec": 207.949,
      "text": "경우도 있고 뭐 10만 원까지 나온"
    },
    {
      "start_sec": 207.959,
      "end_sec": 210.55,
      "text": "경우도 있습니다. 그런데 이제 소비자"
    },
    {
      "start_sec": 210.56,
      "end_sec": 212.35,
      "text": "분쟁 조정 위원회가 아닌 또 개인"
    },
    {
      "start_sec": 212.36,
      "end_sec": 214.50900000000001,
      "text": "정보 분쟁 조정 위원회가 유사한 사례"
    },
    {
      "start_sec": 214.519,
      "end_sec": 216.789,
      "text": "유사한 제도를 운영하고 있거든요."
    },
    {
      "start_sec": 216.799,
      "end_sec": 219.71,
      "text": "여기서 같은 경우는 뭐 이름 성별"
    },
    {
      "start_sec": 219.72,
      "end_sec": 222.11,
      "text": "휴대 전화번호 학력 경력 사진 뭐"
    },
    {
      "start_sec": 222.12,
      "end_sec": 223.589,
      "text": "이력소 자기 소개서 같은 것들이"
    },
    {
      "start_sec": 223.599,
      "end_sec": 225.789,
      "text": "유출된 경우에는 손해 배상 30만"
    },
    {
      "start_sec": 225.799,
      "end_sec": 228.47,
      "text": "원의 조정안을내어 준 적도 있고 뭐"
    },
    {
      "start_sec": 228.48,
      "end_sec": 230.75,
      "text": "성명 생년일 휴대전화가 유출되었으 한"
    },
    {
      "start_sec": 230.76,
      "end_sec": 233.22899999999998,
      "text": "15만 원 정도 이제 조정안이 나온"
    },
    {
      "start_sec": 233.239,
      "end_sec": 235.429,
      "text": "경우도 있습니다. 그런데이 개인 정보"
    },
    {
      "start_sec": 235.439,
      "end_sec": 237.63,
      "text": "분쟁 조정 위원에서 나온 조정 결정에"
    },
    {
      "start_sec": 237.64,
      "end_sec": 240.67,
      "text": "대해서 기업이 조정을 받아들이지"
    },
    {
      "start_sec": 240.68,
      "end_sec": 242.47,
      "text": "않아서 실질적으로 배상이 이루어지지는"
    },
    {
      "start_sec": 242.48,
      "end_sec": 244.39,
      "text": "않습니다. 그래서 이제 저희가 중요한"
    },
    {
      "start_sec": 244.4,
      "end_sec": 246.47,
      "text": "이제 쿠팡에서 나온이 소비자 분쟁"
    },
    {
      "start_sec": 246.48,
      "end_sec": 248.99,
      "text": "조정 위원회에서 나온이 집단 조정"
    },
    {
      "start_sec": 249.0,
      "end_sec": 250.869,
      "text": "제도에서 보면은 한 10만 원"
    },
    {
      "start_sec": 250.879,
      "end_sec": 253.11,
      "text": "정도면은 뭐 아주 많다 이것도"
    },
    {
      "start_sec": 253.12,
      "end_sec": 254.67,
      "text": "아니지만 또 적은 편도 아니다 이렇게"
    },
    {
      "start_sec": 254.68,
      "end_sec": 256.509,
      "text": "볼 수 있을 것 같아요. 근데 만약에"
    },
    {
      "start_sec": 256.519,
      "end_sec": 258.11,
      "text": "이제 이게 분쟁이 이제 분쟁에서"
    },
    {
      "start_sec": 258.12,
      "end_sec": 260.15,
      "text": "조정안이 받아들여지지 않게 되면은"
    },
    {
      "start_sec": 260.16,
      "end_sec": 262.59,
      "text": "재판으로 가게 되는데 재판으로 갔을"
    },
    {
      "start_sec": 262.6,
      "end_sec": 265.909,
      "text": "때는이 조정위원회의 그 결정보다는"
    },
    {
      "start_sec": 265.919,
      "end_sec": 267.83,
      "text": "판결에서 인정된 손해 배상액이"
    },
    {
      "start_sec": 267.84,
      "end_sec": 270.31,
      "text": "줄어두는 경우도 꽤 많고 늘어나는"
    },
    {
      "start_sec": 270.32,
      "end_sec": 271.67,
      "text": "경우도 좀 있습니다. 예."
    },
    {
      "start_sec": 271.68,
      "end_sec": 274.43,
      "text": ">> 그 알 수가 없다는 거네요."
    },
    {
      "start_sec": 274.44,
      "end_sec": 276.99,
      "text": ">> 그러니까 전에 있었던 유사한 사례랑도"
    },
    {
      "start_sec": 277.0,
      "end_sec": 278.629,
      "text": "좀 비교를 해 봐야 되는 거고 그"
    },
    {
      "start_sec": 278.639,
      "end_sec": 281.469,
      "text": "사건의 심각성이나 규모랑도 또 상대"
    },
    {
      "start_sec": 281.479,
      "end_sec": 283.79,
      "text": "비교도 해 봐야 되는 거고요."
    },
    {
      "start_sec": 283.8,
      "end_sec": 286.07,
      "text": "이 집단 분쟁 조정 결과에 따라서"
    },
    {
      "start_sec": 286.08,
      "end_sec": 288.39,
      "text": "변호사이나 뭐 수입료는 어떻게 측정이"
    },
    {
      "start_sec": 288.4,
      "end_sec": 288.59000000000003,
      "text": "돼요?"
    },
    {
      "start_sec": 288.6,
      "end_sec": 290.629,
      "text": ">> 네. 뭐 사실 소비자분들께서 이런"
    },
    {
      "start_sec": 290.639,
      "end_sec": 292.189,
      "text": "이제 제도를 한번 이용해 보실 때"
    },
    {
      "start_sec": 292.199,
      "end_sec": 295.27,
      "text": "가장 궁금해하시는 분일 부분이실 텐데"
    },
    {
      "start_sec": 295.28,
      "end_sec": 297.469,
      "text": ">> 일단은 변호사 수입료 외에 이제"
    },
    {
      "start_sec": 297.479,
      "end_sec": 299.31,
      "text": "들어가는 비용을 한번 절차를 이용할"
    },
    {
      "start_sec": 299.32,
      "end_sec": 300.83,
      "text": "때 저희가 들어가는 비용을 좀 한번"
    },
    {
      "start_sec": 300.84,
      "end_sec": 303.629,
      "text": "살펴볼게요. 어 일단은 법원에 소송을"
    },
    {
      "start_sec": 303.639,
      "end_sec": 306.07,
      "text": "내면은 우리가 법원에다가 인지대"
    },
    {
      "start_sec": 306.08,
      "end_sec": 309.35,
      "text": "송달료 이런 각종 그 비용을 낼 수가"
    },
    {
      "start_sec": 309.36,
      "end_sec": 312.029,
      "text": "있는데 직단 분쟁 조종 절차에서는"
    },
    {
      "start_sec": 312.039,
      "end_sec": 314.31,
      "text": "신청 수수료나 뭐 진행 비용이 전혀"
    },
    {
      "start_sec": 314.32,
      "end_sec": 316.31,
      "text": "들어가지 않습니다. 이런 부분들이"
    },
    {
      "start_sec": 316.32,
      "end_sec": 317.909,
      "text": "소송보다는 굉장히 유리한 점이라고"
    },
    {
      "start_sec": 317.919,
      "end_sec": 320.629,
      "text": "보여질 수 있습니다. 그리고 뭐 한국"
    },
    {
      "start_sec": 320.639,
      "end_sec": 322.71,
      "text": "소비자원 그게 이런 하지만 이제"
    },
    {
      "start_sec": 322.72,
      "end_sec": 324.59,
      "text": "변호사 수입률은 또 따로 들어가는"
    },
    {
      "start_sec": 324.6,
      "end_sec": 326.99,
      "text": "거니까 이거를 좀 알아보면은 일단은"
    },
    {
      "start_sec": 327.0,
      "end_sec": 329.43,
      "text": "집단 분쟁 조정 단계에서 변호사가"
    },
    {
      "start_sec": 329.44,
      "end_sec": 331.749,
      "text": "지원될 변호사의 어떤 서비스가 지원될"
    },
    {
      "start_sec": 331.759,
      "end_sec": 333.95,
      "text": "수가 있습니다. 법으로 소비자"
    },
    {
      "start_sec": 333.96,
      "end_sec": 336.67,
      "text": "기본법에 따르면 집단 분쟁 조정"
    },
    {
      "start_sec": 336.68,
      "end_sec": 339.51,
      "text": "절차에서 사업자가 조정을 거부하면은"
    },
    {
      "start_sec": 339.52,
      "end_sec": 341.749,
      "text": "조정이 불불성립되더라도"
    },
    {
      "start_sec": 341.759,
      "end_sec": 344.51,
      "text": "그 한국 소비자 원이 변호사의"
    },
    {
      "start_sec": 344.52,
      "end_sec": 346.23,
      "text": "선임이나 수입료 지급을 해 줄 수"
    },
    {
      "start_sec": 346.24,
      "end_sec": 348.189,
      "text": "있는 그 법정의 근거가 있습니다."
    },
    {
      "start_sec": 348.199,
      "end_sec": 350.07,
      "text": "조정이 실패하더라도 소비자들이"
    },
    {
      "start_sec": 350.08,
      "end_sec": 352.43,
      "text": "소송으로 갈 때 법률적인 구조를 받을"
    },
    {
      "start_sec": 352.44,
      "end_sec": 354.909,
      "text": "수 있는 이런 그 제도가 갖춰져"
    },
    {
      "start_sec": 354.919,
      "end_sec": 357.23,
      "text": "있고요. 개별적으로 변호사를 선임하는"
    },
    {
      "start_sec": 357.24,
      "end_sec": 359.95,
      "text": "경우에는 뭐 사실 수입료와 수입료는"
    },
    {
      "start_sec": 359.96,
      "end_sec": 361.309,
      "text": "이제 의뢰인과 변호사들 간의"
    },
    {
      "start_sec": 361.319,
      "end_sec": 363.87,
      "text": "개별적으로 정해지는데 집단 분쟁 조정"
    },
    {
      "start_sec": 363.88,
      "end_sec": 366.11,
      "text": "사건 같은 경우는 성공보수를 좀 많이"
    },
    {
      "start_sec": 366.12,
      "end_sec": 368.23,
      "text": "받는데 성공보수 같은 경우는 배상"
    },
    {
      "start_sec": 368.24,
      "end_sec": 371.39,
      "text": "금액의 10%에서 20% 정도를 받는"
    },
    {
      "start_sec": 371.4,
      "end_sec": 373.55,
      "text": "경우입니다. 그래서 사실 이제"
    },
    {
      "start_sec": 373.56,
      "end_sec": 375.35,
      "text": "개인적으로 변해서 선임하면은 비용이"
    },
    {
      "start_sec": 375.36,
      "end_sec": 377.79,
      "text": "많이 들고 이게 배상금보다 선입가 더"
    },
    {
      "start_sec": 377.8,
      "end_sec": 379.43,
      "text": "많이 들 수 있잖아요. 배보다 배꼽이"
    },
    {
      "start_sec": 379.44,
      "end_sec": 382.309,
      "text": "더 커질 수 있는데 뭐 이렇게 다수가"
    },
    {
      "start_sec": 382.319,
      "end_sec": 384.23,
      "text": "모여서 하면은 사실 이런 부분들을"
    },
    {
      "start_sec": 384.24,
      "end_sec": 386.589,
      "text": "많이 감밀 수 있는 그런 장점들이"
    },
    {
      "start_sec": 386.599,
      "end_sec": 388.95,
      "text": "있겠죠. 결론적으로는 뭐 집단 분쟁"
    },
    {
      "start_sec": 388.96,
      "end_sec": 391.15,
      "text": "조정 절차에서 변호사를 꼭 필요하진"
    },
    {
      "start_sec": 391.16,
      "end_sec": 394.30899999999997,
      "text": "않고 만약에 필요하다 하더라도 이제"
    },
    {
      "start_sec": 394.319,
      "end_sec": 396.029,
      "text": "뭐 무료로 지원받을 수 있는 부분들이"
    },
    {
      "start_sec": 396.039,
      "end_sec": 398.15,
      "text": "있다라고 하는 부분들을 좀 알아두시면"
    },
    {
      "start_sec": 398.15999999999997,
      "end_sec": 399.27,
      "text": "좋겠습니다."
    },
    {
      "start_sec": 399.28,
      "end_sec": 402.11,
      "text": ">> 그러니까 약 10만 원 정도의 조정을"
    },
    {
      "start_sec": 402.12,
      "end_sec": 403.909,
      "text": "통해서 이제 배상을 받았다면 변호사"
    },
    {
      "start_sec": 403.919,
      "end_sec": 405.27,
      "text": "비용이 한 1, 2만 원 정도 되는"
    },
    {
      "start_sec": 405.28,
      "end_sec": 407.71,
      "text": "거고. 근데 예를 들어서 쿠팡이 뭐"
    },
    {
      "start_sec": 407.72,
      "end_sec": 409.79,
      "text": "한 3,700만 명 넘는 개인 정보"
    },
    {
      "start_sec": 409.8,
      "end_sec": 411.71,
      "text": "유출됐다고 하지 않았습니까? 어 나"
    },
    {
      "start_sec": 411.72,
      "end_sec": 413.909,
      "text": "몰랐었는데 이런 뉴스가 있네."
    },
    {
      "start_sec": 413.919,
      "end_sec": 415.629,
      "text": "지금이라도 [콧방귀] 나도 추후에"
    },
    {
      "start_sec": 415.639,
      "end_sec": 417.39,
      "text": "조정 신청을 어떻게 할 수 있나?"
    },
    {
      "start_sec": 417.4,
      "end_sec": 419.83,
      "text": "참여할 수 있는 거예요? 아, 일단은"
    },
    {
      "start_sec": 419.84000000000003,
      "end_sec": 422.589,
      "text": "지금 하기에는 좀 늦었다라고 제가"
    },
    {
      "start_sec": 422.599,
      "end_sec": 426.189,
      "text": "말씀드릴 수 있는게 이게 소비자에서이"
    },
    {
      "start_sec": 426.199,
      "end_sec": 428.43,
      "text": "집단 소송 분쟁 소송에 가입할 수가"
    },
    {
      "start_sec": 428.44,
      "end_sec": 430.99,
      "text": "그 제기할 수 있는 소비자를 어떤"
    },
    {
      "start_sec": 431.0,
      "end_sec": 433.39,
      "text": "기간에 신청 기간을 받고 정리를"
    },
    {
      "start_sec": 433.4,
      "end_sec": 436.589,
      "text": "합니다. 이런 경우 같은 경우는 어"
    },
    {
      "start_sec": 436.599,
      "end_sec": 439.39,
      "text": "일단은 올해 같은 경우는 2026년"
    },
    {
      "start_sec": 439.4,
      "end_sec": 441.99,
      "text": "6월 12일부터 26일까지였습니다."
    },
    {
      "start_sec": 442.0,
      "end_sec": 443.67,
      "text": "그니까이 기자님이나 저와 같이 이걸"
    },
    {
      "start_sec": 443.68,
      "end_sec": 445.51,
      "text": "신청하지 않으신 분들은 일단 쿠팡이"
    },
    {
      "start_sec": 445.52,
      "end_sec": 447.43,
      "text": "어떻게 결정을 할 것인가를 보고"
    },
    {
      "start_sec": 447.44,
      "end_sec": 449.43,
      "text": "이제이 다음 스텝을 밟아 나가야"
    },
    {
      "start_sec": 449.44,
      "end_sec": 450.43,
      "text": "됩니다."
    },
    {
      "start_sec": 450.44,
      "end_sec": 452.27,
      "text": ">> 쿠팡 사건처럼 조정위원회가 이미 배상"
    },
    {
      "start_sec": 452.28,
      "end_sec": 454.909,
      "text": "결정을 내리고 만약에 쿠팡이이를"
    },
    {
      "start_sec": 454.919,
      "end_sec": 457.029,
      "text": "수락한 경우라면은 이제 소비자"
    },
    {
      "start_sec": 457.039,
      "end_sec": 460.029,
      "text": "기본법에 따라서 쿠팡이 집단 분쟁"
    },
    {
      "start_sec": 460.039,
      "end_sec": 462.07,
      "text": "조정 당사자가 아닌 피해 소비자에"
    },
    {
      "start_sec": 462.08,
      "end_sec": 464.30899999999997,
      "text": "대한 보상 계획서를 작성해서 조정"
    },
    {
      "start_sec": 464.319,
      "end_sec": 466.029,
      "text": "위원회 제출하도록 권고를 받을 수"
    },
    {
      "start_sec": 466.039,
      "end_sec": 468.55,
      "text": "있습니다. 그러니까이 조정에 참석하지"
    },
    {
      "start_sec": 468.56,
      "end_sec": 471.469,
      "text": "않은 다른 피해자에 대해서 쿠팡이"
    },
    {
      "start_sec": 471.479,
      "end_sec": 474.029,
      "text": "어떻게 일을 배상할 것인가를 그"
    },
    {
      "start_sec": 474.039,
      "end_sec": 476.23,
      "text": "소비자 원에다가 계획서로 제출을 할"
    },
    {
      "start_sec": 476.24,
      "end_sec": 478.029,
      "text": "수 있는 거죠. 그렇게 되면은 사실"
    },
    {
      "start_sec": 478.039,
      "end_sec": 480.189,
      "text": "저와 기자님과 같이 이런 조정 제도에"
    },
    {
      "start_sec": 480.199,
      "end_sec": 483.189,
      "text": "참석 참여하지 않은 분들도 그 계획에"
    },
    {
      "start_sec": 483.199,
      "end_sec": 485.11,
      "text": "따라서 받을 수 있 보상을 받을 수"
    },
    {
      "start_sec": 485.12,
      "end_sec": 487.309,
      "text": "있기 때문에 뭐 굳이 참석을 하지"
    },
    {
      "start_sec": 487.319,
      "end_sec": 489.149,
      "text": "않으셔도 되는데 만약 근데 하지만"
    },
    {
      "start_sec": 489.159,
      "end_sec": 490.95,
      "text": "이거는 권고 사항이고 강제 사항이"
    },
    {
      "start_sec": 490.96,
      "end_sec": 493.11,
      "text": "아니기 때문에 쿠팡이 보상 계획서를"
    },
    {
      "start_sec": 493.12,
      "end_sec": 495.43,
      "text": "제출하지 않으면은 저희 같은 분들은"
    },
    {
      "start_sec": 495.44,
      "end_sec": 497.07,
      "text": "이제 별대로 소송을 제기하는 수밖에"
    },
    {
      "start_sec": 497.08,
      "end_sec": 497.589,
      "text": "없습니다."
    },
    {
      "start_sec": 497.599,
      "end_sec": 500.51,
      "text": ">> 그러니까 기업의 의지를"
    },
    {
      "start_sec": 500.52,
      "end_sec": 502.869,
      "text": "믿고 기다리는 수밖에 없는게 물론"
    },
    {
      "start_sec": 502.879,
      "end_sec": 505.83,
      "text": "이제 강제력이 없는 조정 제도니깐요."
    },
    {
      "start_sec": 505.84,
      "end_sec": 508.469,
      "text": "요거 나중에 아까 말씀하신 것처럼"
    },
    {
      "start_sec": 508.479,
      "end_sec": 510.35,
      "text": "소송으로 갈 수도 있는 거고요."
    },
    {
      "start_sec": 510.36,
      "end_sec": 511.99,
      "text": "기업이 이거다. 아이고 우리 10만"
    },
    {
      "start_sec": 512.0,
      "end_sec": 513.55,
      "text": "원씩 해서 3,700만 명이면"
    },
    {
      "start_sec": 513.56,
      "end_sec": 515.67,
      "text": "얼마야? 얘 못 주겠습니다. 소송 갈"
    },
    {
      "start_sec": 515.68,
      "end_sec": 516.389,
      "text": "수도 있는 거잖아요."
    },
    {
      "start_sec": 516.399,
      "end_sec": 517.11,
      "text": ">> 네. 네."
    },
    {
      "start_sec": 517.12,
      "end_sec": 519.149,
      "text": ">> 그때는 그러면은 누가 어떻게 대표"
    },
    {
      "start_sec": 519.159,
      "end_sec": 520.31,
      "text": "소송으로 가야 되는 겁니까?"
    },
    {
      "start_sec": 520.32,
      "end_sec": 521.7090000000001,
      "text": ">> 그렇죠. 그때 소송으로 이제 가게"
    },
    {
      "start_sec": 521.719,
      "end_sec": 524.99,
      "text": "된다면은 어 소송을 가게 되고 근데"
    },
    {
      "start_sec": 525.0,
      "end_sec": 526.79,
      "text": "지금 이제이 사건에서 소송이 어떻게"
    },
    {
      "start_sec": 526.8,
      "end_sec": 529.19,
      "text": "진행될 것인가를 조금 이제 따져"
    },
    {
      "start_sec": 529.2,
      "end_sec": 531.269,
      "text": "보면요. 네. 어, 사실 재판에서"
    },
    {
      "start_sec": 531.279,
      "end_sec": 532.99,
      "text": "가장 중요한게 손해 배상 사건에서"
    },
    {
      "start_sec": 533.0,
      "end_sec": 536.63,
      "text": "중요한게 이제 회사의 고의나 과실로"
    },
    {
      "start_sec": 536.64,
      "end_sec": 538.71,
      "text": "내가 손해를 입었다라는 부분들을 봐야"
    },
    {
      "start_sec": 538.72,
      "end_sec": 541.03,
      "text": "되는데 지금 같은 경우는 쿠팡의"
    },
    {
      "start_sec": 541.04,
      "end_sec": 543.509,
      "text": "과진급을 6,억 이상을 일단 받은"
    },
    {
      "start_sec": 543.519,
      "end_sec": 545.75,
      "text": "상태예요. 그러니까 일단은 그"
    },
    {
      "start_sec": 545.76,
      "end_sec": 547.949,
      "text": "쿠팡에게 정보 요출에 대한 과실이"
    },
    {
      "start_sec": 547.959,
      "end_sec": 549.389,
      "text": "있다라는 부분들은 일단 어느 정도"
    },
    {
      "start_sec": 549.399,
      "end_sec": 551.91,
      "text": "결정이 되어 있는 사안이라고 보여지고"
    },
    {
      "start_sec": 551.92,
      "end_sec": 554.35,
      "text": "그렇다면은 여기에 대한 손해 배상액을"
    },
    {
      "start_sec": 554.36,
      "end_sec": 556.79,
      "text": "어떻게 결정할 것인가만이 이제 법률적"
    },
    {
      "start_sec": 556.8,
      "end_sec": 559.069,
      "text": "쟁점으로 남았다고 볼 수 있습니다."
    },
    {
      "start_sec": 559.079,
      "end_sec": 560.67,
      "text": "근데 뭐 이렇게 되면은 아 지금"
    },
    {
      "start_sec": 560.68,
      "end_sec": 562.19,
      "text": "실질적으로 돈을 어느 정도 나올"
    },
    {
      "start_sec": 562.2,
      "end_sec": 563.829,
      "text": "것인가라고 보면은 판례를 좀"
    },
    {
      "start_sec": 563.8389999999999,
      "end_sec": 566.949,
      "text": "살펴볼게요. 과거에 카드사 개인 정보"
    },
    {
      "start_sec": 566.959,
      "end_sec": 569.949,
      "text": "대규모 유출 사건에서 법원이 결정한"
    },
    {
      "start_sec": 569.959,
      "end_sec": 571.91,
      "text": "것들은 이제 이름, 주민등록 번호,"
    },
    {
      "start_sec": 571.92,
      "end_sec": 573.99,
      "text": "카드 번호, 금융거래 정보 같은"
    },
    {
      "start_sec": 574.0,
      "end_sec": 576.67,
      "text": "민감한 정보가 유출되고 제3자에게"
    },
    {
      "start_sec": 576.68,
      "end_sec": 579.47,
      "text": "실제로 전달된 경우에는 피해자 1인당"
    },
    {
      "start_sec": 579.48,
      "end_sec": 581.43,
      "text": "10만 원의 위자료를 일단 인정한"
    },
    {
      "start_sec": 581.44,
      "end_sec": 583.47,
      "text": "경우가 있었습니다. 그리고 이건 좀"
    },
    {
      "start_sec": 583.48,
      "end_sec": 586.67,
      "text": "더 특이한 사례인데 데이팅앱 패킹으로"
    },
    {
      "start_sec": 586.68,
      "end_sec": 588.949,
      "text": "개인 정보가 해외 SNS에서 공개된"
    },
    {
      "start_sec": 588.9590000000001,
      "end_sec": 591.35,
      "text": "사건이 있었고 이때는 500만 원의"
    },
    {
      "start_sec": 591.36,
      "end_sec": 593.069,
      "text": "위자료가 인정된 적이 있습니다."
    },
    {
      "start_sec": 593.079,
      "end_sec": 595.59,
      "text": "이때는 뭐 개인 정보가 자산 정보,"
    },
    {
      "start_sec": 595.6,
      "end_sec": 597.75,
      "text": "부동산 계약서, 등본 초본체 아주"
    },
    {
      "start_sec": 597.76,
      "end_sec": 599.67,
      "text": "개인의 아주 민감한 정보가 다"
    },
    {
      "start_sec": 599.68,
      "end_sec": 602.389,
      "text": "유출되었을 경우에 이럴 때는 1인당"
    },
    {
      "start_sec": 602.399,
      "end_sec": 604.11,
      "text": "500만 원의 그 어떤 위자료가"
    },
    {
      "start_sec": 604.12,
      "end_sec": 606.509,
      "text": "인정된 적이 있고 소방 공무원 개인"
    },
    {
      "start_sec": 606.519,
      "end_sec": 608.069,
      "text": "정보 유출 사건에서 20만 원 정도"
    },
    {
      "start_sec": 608.079,
      "end_sec": 611.59,
      "text": "인정됐습니다. 근데 유출된 정보가"
    },
    {
      "start_sec": 611.6,
      "end_sec": 614.11,
      "text": "암화된 비밀번호와 이메일 주소 정도에"
    },
    {
      "start_sec": 614.12,
      "end_sec": 616.23,
      "text": "불과하고 2차 피해가 발생하지"
    },
    {
      "start_sec": 616.24,
      "end_sec": 618.63,
      "text": "않았다라고 하면은 손해가 발생되지"
    },
    {
      "start_sec": 618.64,
      "end_sec": 620.71,
      "text": "않았다라고 해서 청구가 기각된 적도"
    },
    {
      "start_sec": 620.72,
      "end_sec": 622.389,
      "text": "있습니다. 그러니까 소비자들이 진"
    },
    {
      "start_sec": 622.399,
      "end_sec": 623.55,
      "text": "사례들도 있습니다."
    },
    {
      "start_sec": 623.56,
      "end_sec": 625.949,
      "text": ">> 단순 유출이었다. 이걸로 악영된"
    },
    {
      "start_sec": 625.959,
      "end_sec": 628.03,
      "text": "사례가 없으니 실질적 피해나 손해가"
    },
    {
      "start_sec": 628.04,
      "end_sec": 629.79,
      "text": "없었으니 손해 배상할 것도 없는 건"
    },
    {
      "start_sec": 629.8,
      "end_sec": 631.71,
      "text": "아니냐 이런 논리가 먹히기도 하는"
    },
    {
      "start_sec": 631.72,
      "end_sec": 633.79,
      "text": "거예요. 이메일과 암호화된 비밀번호만"
    },
    {
      "start_sec": 633.8,
      "end_sec": 636.71,
      "text": "유출되었을 때 또 이게 조정이긴"
    },
    {
      "start_sec": 636.72,
      "end_sec": 639.31,
      "text": "합니다만 신청부터 결과 나오기까지는"
    },
    {
      "start_sec": 639.32,
      "end_sec": 641.35,
      "text": "얼마나 걸릴까요? 그러니까 일단은"
    },
    {
      "start_sec": 641.36,
      "end_sec": 643.55,
      "text": "집단 분쟁 조정 신청을 접수하면 조정"
    },
    {
      "start_sec": 643.56,
      "end_sec": 645.829,
      "text": "위원회는 60일 이내에 절차 개시"
    },
    {
      "start_sec": 645.8389999999999,
      "end_sec": 647.829,
      "text": "여부를 결정해야 됩니다. 그래서 절차"
    },
    {
      "start_sec": 647.8389999999999,
      "end_sec": 649.79,
      "text": "개시를 하겠다라고 결정을 하면은"
    },
    {
      "start_sec": 649.8,
      "end_sec": 652.11,
      "text": "소비자원에 14일 이상 공고를 해야"
    },
    {
      "start_sec": 652.12,
      "end_sec": 655.03,
      "text": "되고 공고가 끝난 날부터 다음 그"
    },
    {
      "start_sec": 655.04,
      "end_sec": 656.629,
      "text": "30일 이내에 조정을 하셔야 됩니다."
    },
    {
      "start_sec": 656.639,
      "end_sec": 659.069,
      "text": "그리고 정당한 사유가 있으면 2회에"
    },
    {
      "start_sec": 659.079,
      "end_sec": 661.23,
      "text": "한해서 30일씩 연장이 가능합니다."
    },
    {
      "start_sec": 661.24,
      "end_sec": 662.629,
      "text": "그니까 이렇게 따지면 한 3, 4개월"
    },
    {
      "start_sec": 662.639,
      "end_sec": 664.75,
      "text": "정도가 소요되는데 실제로는 좀 더"
    },
    {
      "start_sec": 664.76,
      "end_sec": 667.03,
      "text": "오래 걸립니다. 이번 쿠방 사건 같은"
    },
    {
      "start_sec": 667.04,
      "end_sec": 669.389,
      "text": "경우는 지난해 12월에 집단 분쟁"
    },
    {
      "start_sec": 669.399,
      "end_sec": 671.829,
      "text": "조정 신청되었는데 올해 7월 말해야"
    },
    {
      "start_sec": 671.839,
      "end_sec": 673.71,
      "text": "이제 10만 원 배상하라는 조정"
    },
    {
      "start_sec": 673.72,
      "end_sec": 675.79,
      "text": "결정이 나왔으니까 7, 8개월 정도가"
    },
    {
      "start_sec": 675.8,
      "end_sec": 678.23,
      "text": "소요된 거잖아요. 피자수가 또 많고"
    },
    {
      "start_sec": 678.24,
      "end_sec": 681.03,
      "text": "사실계 사실 관계 확인이나 검토에 좀"
    },
    {
      "start_sec": 681.04,
      "end_sec": 684.069,
      "text": "시간이 걸리기 때문에 좀 시간이 어"
    },
    {
      "start_sec": 684.079,
      "end_sec": 685.75,
      "text": "법에서 정해진 것보다 좀 더 초과되는"
    },
    {
      "start_sec": 685.76,
      "end_sec": 688.069,
      "text": "경우들이 좀 왕이 있습니다."
    },
    {
      "start_sec": 688.079,
      "end_sec": 689.87,
      "text": ">> 중요한 거는 이제 입증 자료잖아요."
    },
    {
      "start_sec": 689.88,
      "end_sec": 692.269,
      "text": "내가 피해를 봤다. 네. 손해 배상을"
    },
    {
      "start_sec": 692.279,
      "end_sec": 694.35,
      "text": "청구할 만한 손해가 있다. 어떤"
    },
    {
      "start_sec": 694.36,
      "end_sec": 695.55,
      "text": "자료를 좀 준비해야 될까요?"
    },
    {
      "start_sec": 695.56,
      "end_sec": 698.11,
      "text": ">> 일단은 쿠팡 회원님을 증명하는 자료."
    },
    {
      "start_sec": 698.12,
      "end_sec": 700.87,
      "text": "가입 이메일 뭐이 쿠팡에 내가 가입한"
    },
    {
      "start_sec": 700.88,
      "end_sec": 702.949,
      "text": "내역이 나의 정보 검색 요런 부분들"
    },
    {
      "start_sec": 702.9590000000001,
      "end_sec": 705.23,
      "text": "보여지는 부분 캡처하셔야 되고요."
    },
    {
      "start_sec": 705.24,
      "end_sec": 706.59,
      "text": ">> 그리고 내가 실제로 쿠팡을"
    },
    {
      "start_sec": 706.6,
      "end_sec": 708.629,
      "text": "이용했다라고 하는 주문 내역이라든가"
    },
    {
      "start_sec": 708.639,
      "end_sec": 711.11,
      "text": "결제 영수증 같은 것 좀 해 놓으셔야"
    },
    {
      "start_sec": 711.12,
      "end_sec": 713.55,
      "text": "되고 또 가장 중요한 거는 개인 정보"
    },
    {
      "start_sec": 713.56,
      "end_sec": 716.15,
      "text": "유출 통지 문자 받으셨잖아요. 우리"
    },
    {
      "start_sec": 716.16,
      "end_sec": 717.79,
      "text": "개인 정보 유출되었다라고 했던 그"
    },
    {
      "start_sec": 717.8,
      "end_sec": 720.11,
      "text": "문자이 부분 캡처해서 보관해 두셔야"
    },
    {
      "start_sec": 720.12,
      "end_sec": 723.11,
      "text": "되고 또 2차 피해 발생이 되었는지를"
    },
    {
      "start_sec": 723.12,
      "end_sec": 725.11,
      "text": "좀 꼭 혹시라도 그런 부분이 있다면"
    },
    {
      "start_sec": 725.12,
      "end_sec": 727.19,
      "text": "거기에 대한 증거가 좀 필요합니다."
    },
    {
      "start_sec": 727.2,
      "end_sec": 729.15,
      "text": "유출된 개인 정보로 뭐 스팸 짜나"
    },
    {
      "start_sec": 729.16,
      "end_sec": 730.55,
      "text": "보이스 피싱 시도가 있었다라는"
    },
    {
      "start_sec": 730.56,
      "end_sec": 732.47,
      "text": "부분들이 입증될 수 있다라면은 그"
    },
    {
      "start_sec": 732.48,
      "end_sec": 735.949,
      "text": "부분도 증명해 주면 좋겠습니다."
    },
    {
      "start_sec": 735.959,
      "end_sec": 738.99,
      "text": ">> 그 피해자 입장에서 일단 집단 분쟁"
    },
    {
      "start_sec": 739.0,
      "end_sec": 740.949,
      "text": "조정을 먼저 신청하는 거랑 바로"
    },
    {
      "start_sec": 740.959,
      "end_sec": 743.59,
      "text": "소송에 직접 가는 거랑 어떤 장단점이"
    },
    {
      "start_sec": 743.6,
      "end_sec": 745.31,
      "text": "있을까요? 일단은 집단 분쟁 조정"
    },
    {
      "start_sec": 745.32,
      "end_sec": 747.47,
      "text": "같은 경우는 비용 부담 없이 다수의"
    },
    {
      "start_sec": 747.48,
      "end_sec": 749.47,
      "text": "피해자가 함께 대응할 수 있기 때문에"
    },
    {
      "start_sec": 749.48,
      "end_sec": 751.67,
      "text": "그리고 또 공고 기관과 처리 기한이"
    },
    {
      "start_sec": 751.68,
      "end_sec": 753.87,
      "text": "이제 법으로 정해져 있으니까 아 내가"
    },
    {
      "start_sec": 753.88,
      "end_sec": 755.91,
      "text": "1년 안에는 뭐 이걸 받겠지라는 어떤"
    },
    {
      "start_sec": 755.92,
      "end_sec": 757.79,
      "text": "예측을 할 수 있다는 부분이 좀 강"
    },
    {
      "start_sec": 757.8,
      "end_sec": 761.11,
      "text": "장점인데 단점은 이제 회사가이"
    },
    {
      "start_sec": 761.12,
      "end_sec": 762.829,
      "text": "조정원을 거부하면은 강제할 수가"
    },
    {
      "start_sec": 762.8389999999999,
      "end_sec": 764.949,
      "text": "없습니다. 조정원 어디까지는 합의를"
    },
    {
      "start_sec": 764.9590000000001,
      "end_sec": 767.43,
      "text": "전제하기 때문에 뭐 회사가 버티면"
    },
    {
      "start_sec": 767.44,
      "end_sec": 769.99,
      "text": "결국 소송으로 가실 수밖에 없습니다."
    },
    {
      "start_sec": 770.0,
      "end_sec": 772.43,
      "text": "소송은 실과 비용이 많이 들지만"
    },
    {
      "start_sec": 772.44,
      "end_sec": 774.59,
      "text": "법원에 이제 확정 판결을 받으면"
    },
    {
      "start_sec": 774.6,
      "end_sec": 776.949,
      "text": "강제집행 가능하다는 거. 니까 상대방"
    },
    {
      "start_sec": 776.9590000000001,
      "end_sec": 779.35,
      "text": "재산에다가 압류, 추심, 뭐 경매"
    },
    {
      "start_sec": 779.36,
      "end_sec": 780.829,
      "text": "이런 거 하실 수 있다라는 점이 좀"
    },
    {
      "start_sec": 780.839,
      "end_sec": 783.23,
      "text": "장점입니다. 그리고 개별 피해 상황에"
    },
    {
      "start_sec": 783.24,
      "end_sec": 786.629,
      "text": "따라서 어 내가 조금 더 큰 배상을"
    },
    {
      "start_sec": 786.639,
      "end_sec": 787.91,
      "text": "받을 수도 있다. 그니까 나 2차"
    },
    {
      "start_sec": 787.92,
      "end_sec": 789.79,
      "text": "피해를 입었다. 이걸로 보이스 피싱을"
    },
    {
      "start_sec": 789.8,
      "end_sec": 791.629,
      "text": "당해서 아주 많은 피해를 입었다라고"
    },
    {
      "start_sec": 791.639,
      "end_sec": 793.47,
      "text": "하면은 좀 더 큰 배상을 받을 수"
    },
    {
      "start_sec": 793.48,
      "end_sec": 796.949,
      "text": "있다라고 하는 장점이 있습니다."
    },
    {
      "start_sec": 796.959,
      "end_sec": 799.43,
      "text": ">> 아무래도 요거는 또 이제 산에 따라서"
    },
    {
      "start_sec": 799.44,
      "end_sec": 801.67,
      "text": "달라질테니까 그 가능성도 그렇고요."
    },
    {
      "start_sec": 801.68,
      "end_sec": 803.15,
      "text": "전문가에 좀 조언을 받아보는 것도"
    },
    {
      "start_sec": 803.16,
      "end_sec": 805.11,
      "text": "좋을 것 같네요. 씨 윤예림"
    },
    {
      "start_sec": 805.12,
      "end_sec": 806.43,
      "text": "변호사였습니다. 고맙습니다."
    },
    {
      "start_sec": 806.44,
      "end_sec": 808.56,
      "text": ">> 네."
    }
  ]
}