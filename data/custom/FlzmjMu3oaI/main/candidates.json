        {
          "start_sec": 681.279,
          "end_sec": 684.19,
          "text": "참여하면서 자발적으로 사용하는 기간이"
        },
        {
          "start_sec": 684.2,
          "end_sec": 686.59,
          "text": "늘어나야 된다는 거죠. 단순히 계산"
        },
        {
          "start_sec": 686.6,
          "end_sec": 689.87,
          "text": "때에 줄이 길거나 상품을 찾지 못해서"
        },
        {
          "start_sec": 689.88,
          "end_sec": 693.11,
          "text": "매장을 헤매는 시간은 이 유효 시간이"
        },
        {
          "start_sec": 693.12,
          "end_sec": 693.99,
          "text": "네. 아니라는"
        },
        {
          "start_sec": 694.0,
          "end_sec": 696.79,
          "text": ">> 것이죠. 그래서 고객을 오래 붙잡는"
        },
        {
          "start_sec": 696.8,
          "end_sec": 699.389,
          "text": "것은 체류고요. 고객이 오래 있고"
        },
        {
          "start_sec": 699.399,
          "end_sec": 701.43,
          "text": "싶게 만드는 것은 경험이라고 할 수"
        },
        {
          "start_sec": 701.44,
          "end_sec": 702.11,
          "text": "있습니다."
        }
      ]
    }
  ]
}